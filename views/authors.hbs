<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>LitRate Авторы</title>
    
    <link rel="icon" href="./assets/icon.png" type="image/png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/mainpage.css"  type="text/css">
  </head>
<body>
    <nav class="navbar fixed-top  navbar-expand-lg bg-primary navbar-dark">
      <div class="container-fluid ">
        <img src="./assets/icon.png" width="35px" alt="">
        <a class="navbar-brand px-1" href="/"><h3>LitRate</h3></a>
        
        <div class="collapse navbar-collapse " id="navbarSupportedContent">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0 ">
            <li class="nav-item">
              <a class="nav-link active" aria-current="page" href="/findAuthor">Авторы</a>
            </li>
            <li class="nav-item ">
              <a class="nav-link" href="/genres">Жанры</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/bookshelves">Полки</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/reviews">Рецензии</a>
            </li>
          </ul>
          <form class="d-flex" action="/search" method="POST" role="search">
            <input class="form-control me-2" name="searchText" required type="search" placeholder="Поиск по названию или ISBN" aria-label="Поиск">
            <button class="btn btn-outline-light" type="submit">Поиск</button>
          </form>
        </div>
        {{#if isUser}}
          <div class="collapse navbar-collapse d-flex justify-content-end" >
            <a class="nav-link px-3 text-light fs-3" href="/profile?id={{user._id}}">{{user.login}}</a>
          </div>
        {{else}}
          <div class="collapse navbar-collapse d-flex justify-content-end" >
            <a class="nav-link px-3 text-light" href="/signin">Войти</a>
          </div>
        {{/if}}
          
      </div>
    </nav>
    <div class="container">
        <div class="container d-flex flex-column justify-content-center align-items-center py-5">
            <h2 class="pt-5">Авторы</h2>
            <form class="d-flex py-2" action="/findAuthor" method="POST" role="search">
                <input class="form-control search me-2" type="search" name="searchText" required placeholder="Поиск по авторам" aria-label="Поиск">
                <button class="btn btn-outline-primary" type="submit">Поиск</button>
            </form>
        </div>
    {{#if isPost}}
    <div class="d-inline-flex pt-4 pb-2">
        <p class="fs-3 fw-semibold">Вот что нашлось по вашему результату:</p>
    </div>
    {{/if}}

    <div class=" cards-recomendation d-flex gap-3 py-2">

      {{#each books}}
        <div class="card bg-primary text-light " style="width: 18rem;">
          <a href="/book?bid={{this._id}}" class="no-decoration ">
            <img src="/proxy/image?url=https://libmir.com{{this.cover_id.url}}" crossorigin="anonymous" height="350px" class="card-img-top" >
            <div class="card-body d-flex flex-column justify-content-between">
              <h5 class="card-title">{{this.title}}</h5>
              <div class="d-flex">
                <p class="card-text card-footer">{{this.author_ids.name}} </p>
              </div>
            </div>
          </a>
        </div>
      {{/each}}
    </div>


    <div class="container">
      <footer class="d-flex flex-wrap justify-content-between align-items-center py-3 my-4 border-top">
        <p class="col-md-4 mb-0 text-body-secondary">© 2026, КФ МГТУ им. Н.Э. Баумана, ИУK6-21</p>

        <a href="/" class="col-md-4 d-flex align-items-center justify-content-center mb-3 mb-md-0 me-md-auto link-body-emphasis text-decoration-none">
          <img src="/assets/icon.png" width="40px" alt="">
        </a>

        <p class="col-md-2 mb-0 text-body-secondary">Made by <br> Кирсанов Егор(Ndfj79) <br>  Лескин Евгений(lesochkin)<br>  Полина Коряева(bitterilyyy)</p>
      </footer>
    </div>
     <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>

</body>
</html>