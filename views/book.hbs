<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>LitRate Главная</title>
    <link rel="icon" href="./assets/icon.png" type="image/png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <link rel="stylesheet" href="./css/mainpage.css"  type="text/css">
  </head>
<body>
    <nav class="navbar navbar-expand-lg bg-primary navbar-dark">
      <div class="container-fluid ">
        <img src="./assets/icon.png" width="35px" alt="">
        <a class="navbar-brand px-1" href="/"><h3>LitRate</h3></a>
        
        <div class="collapse navbar-collapse " id="navbarSupportedContent">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0 ">
            <li class="nav-item">
              <a class="nav-link active" aria-current="page" href="/findAuthor">Авторы</a>
            </li>
            <li class="nav-item ">
              <a class="nav-link" href="/genres">Жанры</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/bookshelves">Полки</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/reviews">Рецензии</a>
            </li>
          </ul>
          <form class="d-flex" action="/search" method="POST" role="search">
            <input class="form-control me-2" name="searchText" required type="search" placeholder="Поиск по названию или ISBN" aria-label="Поиск">
            <button class="btn btn-outline-light" type="submit">Поиск</button>
          </form>
        </div>
        {{#if isUser}}
          <div class="collapse navbar-collapse d-flex justify-content-end" >
            <a class="nav-link px-3 text-light fs-3" href="/profile?id={{user._id}}">{{user.login}}</a>
          </div>
        {{else}}
          <div class="collapse navbar-collapse d-flex justify-content-end" >
            <a class="nav-link px-3 text-light" href="/signin">Войти</a>
          </div>
        {{/if}}
          
      </div>
    </nav>

    <div class="container py-5">
        <div class="row align-items-start">
            <div class="col-3">
                <img src="/proxy/image?url=https://libmir.com{{book.cover_id.url}}" width="250px" alt="Обложка книги">
            </div>
            <div class="col-6">
                <h2>{{book.title}}</h2>

                <h5 class="card-subtitle mb-2 text-muted">{{#each book.author_ids}}{{this.name}}; {{/each}}</h5>

                <h6>Жанры:{{#each book.genre_ids}} {{this.name}}; {{/each}}</h6>
                <h5>Рейтинг по сайту: {{bookRate}}</h5>
                {{#if isUser}}
                <h6>Добавить на полку:</h6>
                  {{#each bookshelves}}
                  <div class="btn-group mb-2" role="group" >
                      <button type="button" class="btn btn-primary"><a href="/book/add?id={{this._id}}&bid={{../bookId}}" class="text-white text-decoration-none">{{this.shelfname}}</a></button>
                  </div>
                  {{/each}}
                {{/if}}
                {{#if book.year}}
                <h6 class="card-subtitle mb-2 text-muted">Год издания: {{book.year}}</h6>
                {{/if}}
                <h6 class="card-subtitle mb-2 ">ISBN: {{book.isbn}}</h6>

                <p><strong>Описание:</strong>{{description}}</p>
                <h4>Рецензии: </h4>
                <div class="container d-flex flex-column gap-3">
                  <ul class="list-group">
                  {{#each reviews}}
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                      <a class="link-primary" href="/review?id={{this._id}}">
                        <div class="ms-2 me-auto">
                          <div class="fw-bold">{{this.title}}</div>
                          {{this.user_id.login}}
                        </div>
                      </a>  
                        <div class="">
                          {{#if ../isUser}}
                            {{#if this.isLiked}}
                            <a href="/book/unlike?id={{this._id}}&bid={{../bookId}}">
                              <img class="like" src="./assets/like.png" width='25px' />                
                            </a>
                            {{else}}
                            <a href="/book/like?id={{this._id}}&bid={{../bookId}}">
                              <img class="like" src="./assets/unlike.png" width='25px' />
                            </a>
                            {{/if}}

                          {{else}}
                            <img class="like" src="./assets/unlike.png" width='25px' />   
                          {{/if}}
                            <span class="badge bg-primary rounded-pill">{{this.like_count}}</span>
                        </div>
                    </li>
                  {{/each}}
                  </ul>
                </div>
            </div>

            
            <div class="col-3">
              {{#if isUser}}
              <form action="/book/review?id={{book._id}}" method="POST">
                <div class="mb-3">
                    <h5 for="exampleFormControlInput1" class="form-label">Написать рецензию:</h5>
                    <label for="title" class="form-label">Название рецензии:</label>
                    <input type="form-control" id="title" required name="title">
                    <label for="review" class="form-label">Текст рецензии:</label>
                    <textarea class="form-control" name="textReview"  id="review" rows="3"></textarea>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="rate" required id="inlineRadio1" value="1">
                        <label class="form-check-label" for="inlineRadio1">1</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="rate" required id="inlineRadio2" value="2">
                        <label class="form-check-label" for="inlineRadio2">2</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="rate" required id="inlineRadio3" value="3">
                        <label class="form-check-label" for="inlineRadio3">3</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="rate" required id="inlineRadio1" value="4">
                        <label class="form-check-label" for="inlineRadio1">4</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="rate" required id="inlineRadio2" value="5">
                        <label class="form-check-label" for="inlineRadio2">5</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="rate" required  id="inlineRadio3" value="6">
                        <label class="form-check-label" for="inlineRadio3">6</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="rate" required id="inlineRadio1" value="7">
                        <label class="form-check-label" for="inlineRadio1">7</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="rate" required id="inlineRadio2" value="8">
                        <label class="form-check-label" for="inlineRadio2">8</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="rate" required id="inlineRadio3" value="9">
                        <label class="form-check-label" for="inlineRadio3">9</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="rate" required id="inlineRadio3" value="10">
                        <label class="form-check-label" for="inlineRadio3">10</label>
                      </div>
                    <button class="btn btn-primary mt-2" type="submit">Отправить</button>
                </div>

                </form>
                {{/if}}
            </div>
        </div>
    </div>



    <div class="container">
      <footer class="d-flex flex-wrap justify-content-between align-items-center py-3 my-4 border-top">
        <p class="col-md-4 mb-0 text-body-secondary">© 2026, КФ МГТУ им. Н.Э. Баумана, ИУK6-21</p>

        <a href="/" class="col-md-4 d-flex align-items-center justify-content-center mb-3 mb-md-0 me-md-auto link-body-emphasis text-decoration-none">
          <img src="./assets/icon.png" width="40px" alt="">
        </a>

        <p class="col-md-2 mb-0 text-body-secondary">Made by <br> Кирсанов Егор(Ndfj79) <br>  Лескин Евгений(lesochkin)<br>  Полина Коряева(bitterilyyy)</p>
      </footer>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js" integrity="sha384-fbbOQedDUMZZ5KreZpsbe1LCZPVmfTnH7ois6mU1QK+m14rQ1l2bGBq41eYeM/fS" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
</body>
</html>