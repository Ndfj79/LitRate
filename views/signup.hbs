<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>LitRate Регистрация</title>
    
    <link rel="icon" href="./assets/icon.png" type="image/png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <link rel="stylesheet" href="./css/mainpage.css"  type="text/css">
</head>
<body class="d-flex align-items-center justify-content-center py-4 bg-body-tertiary">
    <form action="/signup" method="post">
        <div class="container d-flex flex-column align-items-center">
            <img class="mb-4" src="./assets/icon.png" alt="" width="72" height="57">
            <h1 class="h3 mb-3 fw-normal">Создание аккаунта</h1>
            <div class="form-floating">
                <input type="text" class="form-control" id="login" name="login" required placeholder="Иван Иванов">
                <label >Имя пользователя</label>
            </div>
            <div class="form-floating">
                <input type="email" class="form-control" name="mail" id="mail" required placeholder="name@example.com">
                <label for="floatingInput">Адрес электронной почты</label>
            </div>
            <div class="form-floating">
                <input type="password" class="form-control" name="password" required id="password" placeholder="Password">
                <label for="floatingPassword">Пароль</label>
            </div>
            <div class="form-floating">
                <input type="password" class="form-control" id="password_confirm" required placeholder="Password">
                <label for="floatingPassword">Подтверждение пароля</label>
            </div>
            <div class="regist">
                <p>Уже зарегистрированы? <a href="/signin" class="link-primary">Войти</a></p>
            </div>
            <button class="btn btn-primary w-100 py-2" type="submit">Создать аккаунт</button>
        </div>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>

</body>
</html>